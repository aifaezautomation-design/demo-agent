# Public hostname of this service, no scheme (Railway: Settings > Networking)
PUBLIC_HOST=your-app.up.railway.app
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WS_AUTH_TOKEN=

TELNYX_API_KEY=
# Portal > Account Settings > Keys & Credentials > Public Key. Strongly recommended in production.
TELNYX_PUBLIC_KEY=

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

MAX_CALL_SECONDS=900

# Local browser test page at http://localhost:8000/test (localhost only; never set on Railway)
ENABLE_TEST_UI=0

# Latency tuning (all optional; defaults shown). Change one at a time and re-measure.
CARTESIA_STREAM_TOKENS=0
# CARTESIA_MAX_BUFFER_MS=100      # only used with CARTESIA_STREAM_TOKENS=1
# DEEPGRAM_ENDPOINTING_MS=10      # unset = Deepgram's default (10 ms), already its minimum
VAD_STOP_SECS=0.2
USER_IDLE_SECS=20
SMART_TURN_STOP_SECS=1.0
USER_TURN_STOP_TIMEOUT=1.5
STALL_SECS=6

# Mia's voice volume, 0.5-2.0 (1.0 = normal). Above ~1.5 the audio starts to clip.
CARTESIA_VOLUME=1.4

# Speech-to-text language: "en" (default). With MULTILINGUAL_ENABLED=1 it defaults to "multi" (nova-3 multilingual).
DEEPGRAM_LANGUAGE=en

# English only unless this is 1 (language detection, Urdu switching, set_language tool).
MULTILINGUAL_ENABLED=0
# "flux" (default): Deepgram Flux, English only. It ends the turn itself and lets the LLM start early. "nova": rollback to nova-3.
DEEPGRAM_STT=nova
# Flux turn detection (optional). The timeout is the longest silence before a turn ends whatever the confidence.
# FLUX_EAGER_EOT_THRESHOLD=0.5
# FLUX_EOT_THRESHOLD=0.7
# FLUX_EOT_TIMEOUT_MS=2000
# Longest reply, in tokens (real replies average ~30).
# OPENAI_MAX_TOKENS=150

# Booking notification emails via Resend (leave RESEND_API_KEY empty to turn them off).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Mia Receptionist <onboarding@resend.dev>
# Demo line only: callback requests and an after-call report (summary + transcript) go here. Empty turns them off.
BOLTIX_LEADS_EMAIL=
